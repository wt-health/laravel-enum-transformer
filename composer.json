{
    "name": "wthealth/laravel-enum-transformer",
    "description": "Transforms bensampo/laravel-enum enums to TypeScript with spatie/typescript-transformer v3",
    "keywords": [
        "webtools",
        "enum",
        "typescript",
        "laravel-typescript-transformer",
        "typescript-transformer"
    ],
    "homepage": "https://github.com/wt-health/laravel-enum-transformer",
    "license": "MIT",
    "authors": [
        {
            "name": "Byron Adams",
            "email": "byron@webtools.co.nz",
            "homepage": "https://webtools.health",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "bensampo/laravel-enum": "^6.14",
        "illuminate/support": "^12.0|^13.0",
        "spatie/typescript-transformer": "^3.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.0",
        "spatie/laravel-typescript-transformer": "^3.0.1"
    },
    "suggest": {
        "spatie/laravel-typescript-transformer": "Runs the transformer from artisan (php artisan typescript:transform), ^3.3 recommended"
    },
    "autoload": {
        "psr-4": {
            "Webtools\\LaravelEnumTransformer\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Webtools\\LaravelEnumTransformer\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "phpunit",
        "format": "pint",
        "lint": "pint --test",
        "analyse": "phpstan analyse --memory-limit=1G",
        "coverage": "phpunit --coverage-clover=build/clover.xml"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    }
}
